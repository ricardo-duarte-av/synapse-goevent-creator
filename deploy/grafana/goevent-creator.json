      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Writes in real rooms forwarded without a check: the read before forwarding took too long (skip_slow), too many reads at once (skip_busy), or too many checks running (dropped).",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "refId": "A",
          "expr": "sum(increase(goevent_shadow_checks_total{job=~\"$job\",check=\"request\",result=~\"skip_slow|skip_busy|dropped\"}[$__range])) or vector(0)",
          "legendFormat": ""
